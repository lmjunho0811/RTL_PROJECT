$version
    TOOL:	xmsim(64)	22.03-s012
$end
$timescale
    1 ps
$end

$scope module tb_FSM $end
$var reg       1 !    clk $end
$var reg       1 "    rst_n $end
$var reg       1 #    din_bit $end
$var reg       1 $    last_bit $end
$var wire      1 %    dout_bit  $end
$var integer  32 &    run_length $end
$var integer  32 '    checks $end
$var integer  32 (    i $end
$var integer  32 )    old_state $end
$var integer  32 *    new_state $end
$var reg      25 +    transitions [24:0] $end

$scope module DUT $end
$var wire      1 ,    clk  $end
$var wire      1 -    rst_n  $end
$var wire      1 .    din_bit  $end
$var wire      1 %    dout_bit  $end
$var parameter  3 /    START $end
$var parameter  3 0    RD0_ONCE $end
$var parameter  3 1    RD1_ONCE $end
$var parameter  3 2    RD0_TWICE $end
$var parameter  3 3    RD1_TWICE $end
$var reg       3 4    state [2:0] $end
$var reg       3 5    next [2:0] $end
$upscope $end


$scope function logical_state $end
$var integer  32 6    logical_state $end
$upscope $end


$scope task check $end
$var reg      256 7    label_text [255:0] $end
$var reg       1 8    expected_out $end
$var reg       3 9    encoded [2:0] $end
$upscope $end


$scope task step $end
$var reg       1 :    bit_value $end
$upscope $end

$upscope $end

$enddefinitions $end
